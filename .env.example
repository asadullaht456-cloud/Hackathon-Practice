# Supabase project URL & Anon Key (from Supabase Dashboard > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Gemini API Key for ID Card OCR (Google AI Studio)
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here

# Switch between mock services and live Supabase ('true' or 'false')
EXPO_PUBLIC_USE_MOCK=true

# Google Maps Android API Key (Build-time for APK)
GOOGLE_MAPS_ANDROID_API_KEY=your-google-maps-android-key-here
